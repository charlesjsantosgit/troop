; Isolated engine-only bake recipe. Use the exact release Godot build.
; Cache hashes include shader code and defines; unmatched groups safely miss.
config_version=5

[application]
config/name="TROOP Metal cache baker"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
config/use_custom_user_dir=true
config/custom_user_dir_name="TROOP-metal-cache-baker"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
